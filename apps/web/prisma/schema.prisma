generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OfferType {
  welcome
  reload
}

enum SourceType {
  template
  url
  text
}

enum OfferStatus {
  draft
  active
  completed
  expired
  cancelled
}

enum OfferStepType {
  qualifying_bet
  qualifying_lay
  bonus_received
  bonus_bet
  bonus_lay
  settlement
}

enum OfferStepStatus {
  pending
  in_progress
  completed
  skipped
}

enum BetType {
  back
  lay
}

enum BetResult {
  won
  lost
  void
  pending
}

enum MatchQuality {
  exact
  strong
  ambiguous
  no_match
}

enum SyncJobType {
  scrape_offer
  parse_terms
  match_lay
  refresh_quote
}

enum SyncJobStatus {
  queued
  running
  completed
  failed
}

model Bookmaker {
  id                   String   @id @default(cuid())
  name                 String   @unique
  region               String?
  supportsDirectScrape Boolean  @default(false)
  scrapeConfigJson     Json?
  offers               Offer[]
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Offer {
  id                  String      @id @default(cuid())
  bookmakerId         String
  isSeed             Boolean     @default(false)
  title               String
  offerType           OfferType
  sourceType          SourceType
  sourceUrl           String?
  rawTerms            String?
  summary             String?
  status              OfferStatus @default(draft)
  expiresAt           DateTime?
  expectedProfit      Decimal?    @db.Decimal(12, 2)
  actualProfit        Decimal?    @db.Decimal(12, 2)
  qualifyingRulesJson Json?
  bonusRulesJson      Json?
  extractedTermsJson  Json?
  bookmaker           Bookmaker   @relation(fields: [bookmakerId], references: [id], onDelete: Restrict)
  steps               OfferStep[]
  bets                Bet[]
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([bookmakerId, status])
  @@index([status, expiresAt])
}

model OfferStep {
  id          String          @id @default(cuid())
  offerId     String
  stepType    OfferStepType
  status      OfferStepStatus @default(pending)
  sortOrder   Int
  notes       String?
  dueAt       DateTime?
  completedAt DateTime?
  offer       Offer           @relation(fields: [offerId], references: [id], onDelete: Cascade)
  bets        Bet[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([offerId, sortOrder])
  @@index([offerId, stepType])
}

model Bet {
  id                 String    @id @default(cuid())
  offerId            String
  offerStepId        String?
  betType            BetType
  sport              String
  eventName          String
  marketName         String
  selectionName      String
  odds               Decimal   @db.Decimal(10, 4)
  stake              Decimal   @db.Decimal(12, 2)
  exchangeCommission Decimal   @db.Decimal(5, 4) @default(0.00)
  result             BetResult @default(pending)
  placedAt           DateTime?
  externalRef        String?
  notes              String?
  offer              Offer     @relation(fields: [offerId], references: [id], onDelete: Cascade)
  offerStep          OfferStep? @relation(fields: [offerStepId], references: [id], onDelete: SetNull)
  layMatches         LayMatch[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([offerId, betType])
  @@index([offerStepId])
}

model LayMatch {
  id                   String       @id @default(cuid())
  backBetId            String       @unique
  matchQuality         MatchQuality
  matchedEventName     String?
  matchedMarketName    String?
  matchedSelectionName String?
  bestLayPrice         Decimal?     @db.Decimal(10, 4)
  bestLaySize          Decimal?     @db.Decimal(12, 2)
  layStake             Decimal?     @db.Decimal(12, 2)
  liability            Decimal?     @db.Decimal(12, 2)
  delayedData          Boolean      @default(true)
  warningsJson         Json?
  rawResponseJson      Json?
  backBet              Bet          @relation(fields: [backBetId], references: [id], onDelete: Cascade)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
}

model SyncJob {
  id           String        @id @default(cuid())
  jobType      SyncJobType
  status       SyncJobStatus @default(queued)
  payloadJson   Json
  resultJson    Json?
  errorMessage  String?
  runAt        DateTime?
  finishedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([jobType, status])
  @@index([runAt])
}
